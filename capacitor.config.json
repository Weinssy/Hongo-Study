{
  "appId": "io.github.weinssy.hongostudy",
  "appName": "Hongo Study",
  "webDir": "dist-android",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 150,
      "launchAutoHide": false,
      "backgroundColor": "#FAF8F5",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FAF8F5"
    }
  }
}
